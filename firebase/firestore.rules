rules_version = '2';

// Auth-phase Firestore rules for barakah-40-a5dac.
// Authenticated users may only read/write their own users/{uid}.
// All other paths are denied.

service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    function isMe(uid) {
      return signedIn() && request.auth.uid == uid;
    }

    match /users/{userId} {
      allow read, write: if isMe(userId);
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}

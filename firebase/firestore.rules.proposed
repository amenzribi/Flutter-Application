rules_version = '2';

// PROPOSED / source-of-truth copy mirrors firebase/firestore.rules.
// Deploy only after emulator rules tests pass AND explicit approval:
//   firebase deploy --only firestore:rules --project barakah-40-a5dac

service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    function isMe(uid) {
      return signedIn() && request.auth.uid == uid;
    }

    match /users/{userId} {
      allow read, write: if isMe(userId);
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
